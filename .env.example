# Copy to .env (git-ignored) and adjust. In Docker the same variables are set
# by docker-compose.yaml with service names instead of localhost.
POSTGRES_DSN=host=localhost user=myuser password=mypassword dbname=mydb port=5432 sslmode=disable search_path=shipment-service
KAFKA_BROKERS=localhost:9092
KAFKA_PRODUCER_TOPIC=shipment-service
KAFKA_CONSUMER_TOPICS=payment-service
KAFKA_GROUP_ID=shipment-service
PORT=8081
LOGLEVEL=info
ALLOWED_ORIGINS=*
